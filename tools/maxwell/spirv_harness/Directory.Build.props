<Project>
  <!-- Build products go to private/build/spirv_harness, never next to the sources. Must be set before the SDK is
       imported, which is why it lives here and not in the .csproj. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../private/build/spirv_harness/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../private/build/spirv_harness/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
