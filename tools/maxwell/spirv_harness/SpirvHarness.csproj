<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline Maxwell -> SPIR-V through Ryujinx's shader translator (MIT). See docs/nvn/TRANSLATOR.md.
       The translator is not vendored: it is referenced from a local checkout in private/third_party/ryubing. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>spirv_harness</AssemblyName>
    <RootNamespace>SpirvHarness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../private/third_party/ryubing/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
  </ItemGroup>

</Project>
