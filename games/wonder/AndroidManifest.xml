<?xml version="1.0" encoding="utf-8"?>
<!-- NativeActivity app: all code is in libwonder.so (android_main). No game data inside: the player copies their
     own dump, keys-derived files and shader translation to "Internal storage/Super Mario Bros. Wonder"
     (see docs/nvn/ANDROID-PORT.md). A private build for the owner of the cartridge: never published. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.belmantegu.wonderrecomp"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Vulkan 1.3: timeline semaphores, synchronization2 and dynamic rendering (docs/nvn/ANDROID-PORT.md 3.1). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Wonder"
        android:requestLegacyExternalStorage="true"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:isGame="true"
        android:appCategory="game"
        android:largeHeap="true"
        android:theme="@style/Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="wonder" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
